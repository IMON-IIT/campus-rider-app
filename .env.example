# JU Smart Ride - Environment Configuration Example
# Copy this file to .env and adjust variables as required

# Database Configuration
POSTGRES_DB=jusmartride
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Backend Configuration
SERVER_PORT=8080
JWT_SECRET=ju_smart_ride_super_secure_jwt_secret_key_minimum_256_bits_length!
JWT_EXPIRATION_HOURS=24

# Routing Constraints
MAX_DETOUR_RATIO=0.45
MAX_EXTRA_DISTANCE_METERS=750.0
MAX_EXTRA_TIME_SECONDS=240

# Mobile Application
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_WS_URL=http://localhost:8080/ws
